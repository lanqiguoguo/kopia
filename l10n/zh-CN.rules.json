[
  ["^Every (\\d+) seconds?$", "每 $1 秒"],
  ["^Every (\\d+) minutes?$", "每 $1 分钟"],
  ["^Every (\\d+) hours?$", "每 $1 小时"],
  ["^Every (\\d+) days?$", "每 $1 天"],
  ["^(\\d+) seconds? ago$", "$1 秒前"],
  ["^(\\d+) minutes? ago$", "$1 分钟前"],
  ["^(\\d+) hours? ago$", "$1 小时前"],
  ["^(\\d+) days? ago$", "$1 天前"],
  ["^in (\\d+) seconds?$", "$1 秒后"],
  ["^in (\\d+) minutes?$", "$1 分钟后"],
  ["^in (\\d+) hours?$", "$1 小时后"],
  ["^in (\\d+) days?$", "$1 天后"],
  ["^Page Size: (\\d+)$", "每页 $1 条"],
  ["^Repository in ([^:]+): (.+)$", "仓库（$1）：$2"]
]
